# Rotterdam Live - Environment Configuration Template
PROJECT_NAME="Rotterdam Live Unified Data Engine"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# CORS Origins (JSON list of allowed origins)
CORS_ORIGINS='["https://rotterdamlive.nl","https://www.rotterdamlive.nl","http://localhost:5173","http://localhost:3000"]'

# PostgreSQL with PostGIS
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=${SERVICE_PASSWORD}
POSTGRES_DB="rotterdamlive"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:${SERVICE_PASSWORD}@db:5432/rotterdamlive"
DATABASE_URL_SYNC="postgresql://postgres:${SERVICE_PASSWORD}@db:5432/rotterdamlive"

# Redis Cache & Message Broker
REDIS_URL="redis://redis:6379/0"

# Ingestion Polling Frequencies (seconds)
P2000_POLL_INTERVAL_SECONDS=60
MOBILITY_POLL_INTERVAL_SECONDS=60
BRIDGES_POLL_INTERVAL_SECONDS=120
TRANSIT_POLL_INTERVAL_SECONDS=30
NEWS_POLL_INTERVAL_SECONDS=300
WEATHER_POLL_INTERVAL_SECONDS=600
AIR_QUALITY_POLL_INTERVAL_SECONDS=900
SPATIAL_BASELINE_SYNC_HOURS=24

# External APIs (Optional API keys if user registers for dedicated quotas)
# Note: In Phase 1, all feeds use free public endpoints that require zero API keys.
PDOK_API_KEY=""
OPEN_DATA_SOFT_KEY=""
OPENOV_API_KEY=""
