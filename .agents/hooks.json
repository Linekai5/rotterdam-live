{
  "global-artifacts-sync": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 /home/homeaccount/.gemini/config/scripts/sync_artifacts.py --event session_start",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/homeaccount/.gemini/config/scripts/sync_artifacts.py --event post_tool_use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
